BEGIN
{{
	printf("ready %d\\n", walltimestamp);
}}

{send}

{receive}

/* libdispatch sends the messages of XPC connections, and of its other Mach channels,
   here. arg0 is the channel, whose label is the service name, and it makes the trap
   below on this thread before it returns, which it does only through ret. */
pid$target:libdispatch.dylib:_dispatch_mach_msg_send:entry
{{
	self->channel = arg0;
}}

