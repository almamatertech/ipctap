#!/usr/bin/env python3
"""ipctap traces CoreIPC messages between the processes of Safari, or another app that uses WebKit,
and the other Mach messages they send, with DTrace.

  sudo ./ipctap trace [-a APP] [-p PROCESS] [-m MESSAGE] [-o FILE] [-t SECONDS] [--bytes [N]]
                      trace Safari or APP until Ctrl-C, or for SECONDS
  ./ipctap show FILE [-p PROCESS] [-m MESSAGE]
                      print a trace saved as ndjson
  ./ipctap setup      read this Mac's WebKit and write its D scripts (trace does this when needed)
"""
