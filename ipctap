/pid == $target/
{{
	this->id = (uint64_t)arg4 >> 32;
	this->send = (arg1 & 0x1) && !(arg1 & 0x200000000) && this->id != 0xdba0dba && this->id != 0xdba1dba;
	this->size = (uint64_t)arg2 >> 32;
	this->label = "-";
}}

/* A vector send has the count of vectors where the size was. The first vector,
   24 bytes, is the message, with its size 16 bytes in. */
