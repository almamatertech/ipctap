VERSION = "1.0.0"
WEBKIT = "/System/Library/Frameworks/WebKit.framework/Versions/A/WebKit"
LIBDISPATCH = "/usr/lib/system/libdispatch.dylib"
BUILDS = os.path.join(os.path.dirname(os.path.realpath(__file__)), "builds")
PROCESSES = ["UI", "Networking", "GPU", "WebContent", "Model", "?"]  # WebKit's ProcessName order
PAIRING = 100_000_000  # ns. A receive almost always lands within 1 ms of its send.
HOLD = 3_000_000_000  # ns. How long a Mach message waits for an lsmp snapshot that has its port.
# XPC's msgh_ids: a message, a reply, a notification, a message that waits for its reply, and the
# two check-ins a new connection starts with.
XPC_IDS = {0x10000000, 0x20000000, 0x30000000, 0x40000000, 0x77303074, 0x77494e74}
ISSUES = "https://github.com/almamatertech/ipctap/issues"

# The functions setup reads, by the start of their mangled names.
FUNCTIONS = {
    "encoder": "__ZN3WTF35makeUniqueRefWithoutFastMallocCheckIN3IPC7EncoderEJNS1_11MessageNameEyEEE",
    "send": "__ZN3IPC10Connection15sendMessageImplE",
    "send_outgoing": "__ZN3IPC10Connection19sendOutgoingMessageE",
    "receive": "__ZN3IPC10Connection22processIncomingMessageEN3WTF9UniqueRefINS_7DecoderEEE",
    "decoder": "__ZN3IPC7Decoder6createENSt3__14spanIKhLm18446744073709551615EEEON3WTF8Function",
    "decode_name": "__ZN3IPC7Decoder6decodeINS_11MessageNameEEE",
}


def uuids():
    """The UUIDs of WebKit and libdispatch, whose fields the D scripts read."""
    out = subprocess.run(["dyld_info", "-uuid", WEBKIT, LIBDISPATCH], capture_output=True, text=True,
                         check=True).stdout
    return re.findall(r"[0-9A-F]{8}(?:-[0-9A-F]{4}){3}-[0-9A-F]{12}", out)


# Setup


def stream_receiver(symbol):
    """The class in WebKit::<class>::didReceiveStreamMessage(IPC::StreamServerConnection&, IPC::Decoder&)."""
    m = re.match(r"__ZN6WebKit(\d+)", symbol)
    if m:
        end = m.end() + int(m[1])
        rest = symbol[end:]
        if rest.startswith("23didReceiveStreamMessageERN3IPC22StreamServerConnectionERN") and rest.endswith("_7DecoderE"):
            return symbol[m.end():end]
    return None


def webkit_function(symbol):
    """The FUNCTIONS key of a WebKit symbol, or the class of a stream receiver."""
    for key, prefix in FUNCTIONS.items():
        if symbol.startswith(prefix):
            return key
    return stream_receiver(symbol)


def disassemble(path, wanted):
    """Disassemble path, keeping each function that wanted(symbol) gives a key. Returns, by key,
    the function's instructions as (mnemonic, operands, comment), and their addresses."""
    code, addresses = {}, {}
    current = None
    dis = subprocess.Popen(["dyld_info", "-disassemble", path], stdout=subprocess.PIPE, text=True, errors="replace")
    for line in dis.stdout:
        if line.startswith("0x"):
            if current is not None:
                text, _, comment = line.partition(";")
                parts = text.split(None, 2)
                current.append((parts[1], parts[2].strip() if len(parts) > 2 else "", comment.strip()))
                addresses[key].append(int(parts[0], 16))
            continue
        key = wanted(line.rstrip().rstrip(":"))
        current = None
        if key in code:
            sys.exit(f"setup: two functions in {path} match {key}")
        if key:
            current = code[key] = []
            addresses[key] = []
    if dis.wait():
        sys.exit(f"setup: dyld_info -disassemble {path} failed")
    return code, addresses


def arguments(code):
    """Registers that copy x0 or x1 before the function's first call."""
    copies = {}
    for op, args, _ in code:
        if op == "bl":
            break
        m = re.fullmatch(r"(x\d+), (x[01])", args)
        if op == "mov" and m:
            copies[m[1]] = m[2]
    return copies


def encoder_offsets(code):
    """Name and destination offsets from the Encoder constructor. It loads the name
    through its first argument and the destination through its second, and stores
    both into the new Encoder, which the allocation call returns in x0."""
    copies = arguments(code)
    name_reg = dest_reg = name = dest = None
    for op, args, _ in code:
        m = re.fullmatch(r"(\w+), \[(x\d+)\]", args)
        if op == "ldrh" and m and copies.get(m[2]) == "x0":
            name_reg = m[1]
        if op == "ldr" and m and copies.get(m[2]) == "x1":
            dest_reg = m[1]
        m = re.fullmatch(r"(\w+), \[x0(?:, #(\w+))?\]", args)
        if op == "strh" and m and m[1] == name_reg and name is None:
            name = int(m[2] or "0", 0)
        if op == "str" and m and m[1] == dest_reg and dest is None:
            dest = int(m[2] or "0", 0)
    return name, dest


def encoder_size_offset(code):
    """The Encoder's size field, which sendOutgoingMessage compares with the
    512-byte inline buffer."""
    found = set()
    for (op0, args0, _), (op, args, _), (op2, args2, _) in zip(code, code[1:], code[2:]):
        limit = re.fullmatch(r"w(\d+), #0x200", args0)
        m = re.fullmatch(r"x(\d+), \[x\d+, #(\w+)\]", args)
        if op0 == "mov" and limit and op == "ldr" and m and op2 == "cmp" and args2 == f"x{m[1]}, x{limit[1]}":
            found.add(int(m[2], 0))
    return found.pop() if len(found) == 1 else None


def encoder_buffer_offsets(code):
    """Where sendOutgoingMessage finds the Encoder's bytes, as the offsets of its out-of-line
    buffer pointer and of the inline buffer it uses when that pointer is null."""
    for (op0, args0, _), (op1, args1, _), (op2, args2, _) in zip(code, code[1:], code[2:]):
        m = re.fullmatch(r"(x\d+), \[(x\d+), #(\w+)\]", args0)
        if op0 == "ldr" and m and op1 == "cbnz" and args1.startswith(m[1] + ","):
            inline = re.fullmatch(rf"{m[1]}, {m[2]}, #(\w+)", args2)
            if op2 == "add" and inline:
                return int(m[3], 0), int(inline[1], 0)
    return None, None


def name_offset(code):
    """The offset of the first 16-bit load, which reads the message name."""
    for op, args, _ in code:
        m = re.fullmatch(r"w\d+, \[x\d+(?:, #(\w+))?\]", args)
        if op == "ldrh" and m:
            return int(m[1] or "0", 0)
    return None


def decoder_offsets(code):
    """Buffer, size, read position, name and destination offsets from Decoder::create.
    It stores its buffer (x0) and size (x1) at the start of the new Decoder and the
    buffer again as the read position, then the result of decode<MessageName> as the
    name, then the destination once it isn't -1."""
    copies = arguments(code)
    buffer = size = position = name = dest = buffer_reg = base = None
    decoded_name = False
    for i, (op, args, _) in enumerate(code):
        m = re.fullmatch(r"(x\d+), (x\d+), \[(x\d+)(?:, #(\w+))?\]", args)
        if op == "stp" and m and copies.get(m[1]) == "x0" and copies.get(m[2]) == "x1" and size is None:
            buffer_reg, base, buffer = m[1], m[3], int(m[4] or "0", 0)
            size = buffer + 8
        m = re.fullmatch(r"(x\d+), \[(x\d+), #(\w+)\]", args)
        if op == "str" and m and buffer_reg and (m[1], m[2]) == (buffer_reg, base) and position is None:
            position = int(m[3], 0)
        if op == "bl" and "decodeINS_11MessageName" in args:
            decoded_name = True
        m = re.fullmatch(r"w0, \[x\d+, #(\w+)\]", args)
        if op == "strh" and m and decoded_name and name is None:
            name = int(m[1], 0)
        m = re.fullmatch(r"(x\d+), #0x1", args)
        if op == "cmn" and m and dest is None:
            for op2, args2, _ in code[i + 1:i + 4]:
                stored = re.fullmatch(rf"{m[1]}, \[x\d+, #(\w+)\]", args2)
                if op2 == "str" and stored:
                    dest = int(stored[1], 0)
                    break
    return buffer, size, position, name, dest


def position_stores(code):
    """The offsets decode<MessageName> stores to in its Decoder (x0), where it moves the read position."""
    return {int(m[1], 0) for op, args, _ in code for m in [re.fullmatch(r"x\d+, \[x0, #(\w+)\]", args)]
            if op == "str" and m}


def reply_check(code):
    """The Decoder name offset processIncomingMessage reads before comparing the name
    with two reply IDs, and those IDs."""
    for i, (op, args, _) in enumerate(code):
        m = re.fullmatch(r"w\d+, \[x\d+, #(\w+)\]", args)
        if op == "ldrh" and m:
            ids = [int(c, 0) for op2, args2, _ in code[i + 1:i + 5] if op2 == "mov" for c in re.findall(r"#(\w+)$", args2)]
            if len(ids) >= 2:
                return int(m[1], 0), set(ids[:2])
    return None, None


def message_table(code):
    """The address of messageDescriptions in processIncomingMessage, and the largest
    message ID it looks up there."""
    table = last = None
    pages = {}
    for i, (op, args, comment) in enumerate(code):
        m = re.fullmatch(r"(x\d+), \d+", args)
        if op == "adrp" and m and re.fullmatch(r"0x[0-9a-f]+", comment):
            pages[m[1]] = int(comment, 16)
        m = re.fullmatch(r"x\d+, (x\d+), #(\w+)", args)
        if op == "add" and m and comment == "__ZN3IPC6Detail19messageDescriptionsE" and m[1] in pages:
            table = pages[m[1]] + int(m[2], 0)
        # The last ID is a constant the next instructions clamp the ID to, with umin (FEAT_CSSC)
        # in the M6's arm64e.x1 code, and with a cmp and a csel in the arm64e code other Macs run.
        m = re.fullmatch(r"(w\d+), #(\w+)", args)
        if op == "mov" and m and last is None and i + 2 < len(code):
            (op1, args1, _), (op2, args2, _) = code[i + 1:i + 3]
            args1, args2 = args1.split(", "), args2.split(", ")
            umin = op1 == "umin" and m[1] in args1
            csel = (op1, op2) == ("cmp", "csel") and m[1] in args1 and m[1] in args2 and args2[-1] == "lo"
            if umin or csel:
                last = int(m[2], 0)
    return table, last


def read_names(table):
    """IPC::Detail::messageDescriptions, read from WebKit loaded into this process.
    Each 24-byte entry starts with the name and its length, and its bytes 18 and
    19 are the sending and receiving process."""
    ctypes.CDLL(WEBKIT)
    dyld = ctypes.CDLL(None)
    dyld._dyld_get_image_name.restype = ctypes.c_char_p
    dyld._dyld_get_image_vmaddr_slide.restype = ctypes.c_long
    slide = next(dyld._dyld_get_image_vmaddr_slide(i) for i in range(dyld._dyld_image_count())
                 if dyld._dyld_get_image_name(i).endswith(b"/WebKit.framework/Versions/A/WebKit"))
    names = []
    while len(names) < 65536:
        entry = table + slide + 24 * len(names)
        text = ctypes.c_uint64.from_address(entry).value
        length = ctypes.c_uint64.from_address(entry + 8).value
        if not text or not 1 < length < 512:
            break
        name = ctypes.string_at(text, length)
        if name[-1] != 0 or not name[:-1].isascii():
            break
        sender, receiver = ctypes.string_at(entry + 18, 2)
        unknown = len(PROCESSES) - 1
        names.append((name[:-1].decode(), PROCESSES[min(sender, unknown)], PROCESSES[min(receiver, unknown)]))
        if names[-1][0] == "<invalid message name>":
            return names
    sys.exit(f"setup: entry {len(names)} of the message table doesn't look like a name")


def own_process(names):
    """Whether each message to these receivers goes to the process the receiver lives in."""
    homes = {"WebPage": "WebContent", "WebPageProxy": "UI", "NetworkConnectionToWebProcess": "Networking",
             "GPUConnectionToWebProcess": "GPU"}
    return all(receiver == homes[name.split("_")[0]] for name, _, receiver in names
               if name.split("_")[0] in homes and not name.endswith("Reply"))


def label_offset(code):
    """Where dispatch_queue_get_label reads a queue's label, which for the channel
    of an XPC connection is the service name."""
    for op, args, _ in code:
        m = re.fullmatch(r"x\d+, \[x0, #(\w+)\]", args)
        if op == "ldr" and m:
            return int(m[1], 0)
    return None


def only_returns(code, addresses):
    """Whether a function leaves only through ret, never by a branch out of it, so
    that a DTrace return probe sees it leave."""
    inside = set(addresses)
    for op, args, _ in code:
        target = args.split(", ")[-1]
        branch = op == "b" or op.startswith("b.") or op in ("cbz", "cbnz", "tbz", "tbnz")
        if re.fullmatch(r"br(a[ab]z?)?", op) or branch and not (re.fullmatch(r"0x[0-9a-f]+", target)
                                                               and int(target, 16) in inside):
            return False
    return any(op.startswith("ret") for op, _, _ in code)


def channel_checks(label):
    """Make a dispatch channel like the ones XPC connections use, never connected, so
    it sends nothing, and compare its label field with dispatch_queue_get_label."""
    lib = ctypes.CDLL(None)
    handler = ctypes.CFUNCTYPE(None, ctypes.c_void_p, ctypes.c_ulong, ctypes.c_void_p, ctypes.c_int)(lambda *_: None)
    lib.dispatch_mach_create_f.restype = ctypes.c_void_p
    lib.dispatch_mach_create_f.argtypes = [ctypes.c_char_p, ctypes.c_void_p, ctypes.c_void_p, type(handler)]
    lib.dispatch_queue_get_label.restype = ctypes.c_char_p
    lib.dispatch_queue_get_label.argtypes = [ctypes.c_void_p]
    lib.malloc_size.restype = ctypes.c_size_t
    lib.malloc_size.argtypes = [ctypes.c_void_p]
    channel = lib.dispatch_mach_create_f(b"com.apple.ipctap.setup", None, None, handler)
    return {
        "a dispatch channel's label field holds the label dispatch_queue_get_label gives":
            ctypes.string_at(ctypes.c_uint64.from_address(channel + label).value) == b"com.apple.ipctap.setup"
            == lib.dispatch_queue_get_label(channel),
        "the label field is inside the channel": lib.malloc_size(channel) >= label + 8,
    }


