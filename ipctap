/* Once the receiver has decoded a stream message, the Decoder's read position is at its end.
   The Decoder's buffer starts where the message starts, so the difference is its size. Every
   return follows its own entry, so self->decoder stays set rather than being freed for each
   message, which at thousands of messages a second makes DTrace drop thread-local variables. */
{returns}
/self->decoder/
{{
	printf("size %d %d %d\\n", self->time, tid,
	    *(uint64_t *)copyin(self->decoder + {dec_position:#x}, 8) -
	    *(uint64_t *)copyin(self->decoder + {dec_buffer:#x}, 8));
}}
"""


def setup():
    started = time.time()
    uuid, libdispatch = uuids()
    code, _ = disassemble(WEBKIT, webkit_function)
    for key, prefix in FUNCTIONS.items():
        if key not in code:
            sys.exit(f"setup: found no function starting {prefix}")
    receivers = sorted(key for key in code if key not in FUNCTIONS)
    dispatch, addresses = disassemble(LIBDISPATCH, lambda symbol: symbol if symbol in (
        "_dispatch_queue_get_label", "__dispatch_mach_msg_send") else None)
    for symbol in ("_dispatch_queue_get_label", "__dispatch_mach_msg_send"):
        if symbol not in dispatch:
            sys.exit(f"setup: found no {symbol} in libdispatch")
    dispatch_label = label_offset(dispatch["_dispatch_queue_get_label"])
    enc_name, enc_dest = encoder_offsets(code["encoder"])
    enc_size = encoder_size_offset(code["send_outgoing"])
    enc_buffer, enc_inline = encoder_buffer_offsets(code["send_outgoing"])
    dec_buffer, dec_size, dec_position, dec_name, dec_dest = decoder_offsets(code["decoder"])
    recv_name, replies = reply_check(code["receive"])
    table, last = message_table(code["receive"])
    found = {"Encoder name": enc_name, "Encoder destination": enc_dest, "Encoder size": enc_size,
             "Encoder buffer": enc_buffer,
             "Decoder name": dec_name, "Decoder destination": dec_dest, "Decoder size": dec_size,
             "Decoder read position": dec_position,
             "reply IDs in processIncomingMessage": replies, "message table": table,
             "last message ID": last, "dispatch queue label": dispatch_label}
    missing = [what for what, value in found.items() if value is None]
    if missing:
        sys.exit("setup: couldn't find the " + ", ".join(missing))
    if not receivers:
        sys.exit("setup: found no stream receivers")
    names = read_names(table)
    ids = {name: i for i, (name, _, _) in enumerate(names)}
    checks = {
        "the Encoder constructor and sendOutgoingMessage read the name at the same offset":
            enc_name == name_offset(code["send_outgoing"]),
        "the Encoder's 512-byte inline buffer ends where its size field starts": enc_inline + 0x200 == enc_size,
        "Decoder::create and processIncomingMessage read the name at the same offset": dec_name == recv_name,
        "Decoder::create and decode<MessageName> keep the read position at the same offset":
            dec_position in position_stores(code["decode_name"]),
        "the reply IDs processIncomingMessage tests are SyncMessageReply and CancelSyncMessageReply":
            replies == {ids.get("SyncMessageReply"), ids.get("CancelSyncMessageReply")},
        "the table ends right after the last ID processIncomingMessage looks up": len(names) - 1 == last + 1,
        "WebPage, WebPageProxy, NetworkConnectionToWebProcess and GPUConnectionToWebProcess messages go to their own process":
            own_process(names),
        **channel_checks(dispatch_label),
        "_dispatch_mach_msg_send, which sends a channel's messages, leaves only through ret":
            only_returns(dispatch["__dispatch_mach_msg_send"], addresses["__dispatch_mach_msg_send"]),
    }

    print(f"WebKit {uuid}, libdispatch {libdispatch}")
    print(f"Encoder  name +{enc_name:#x}  destination +{enc_dest:#x}  size +{enc_size:#x}  "
          f"buffer +{enc_buffer:#x} or inline +{enc_inline:#x}")
    print(f"Decoder  name +{dec_name:#x}  destination +{dec_dest:#x}  size +{dec_size:#x}  position +{dec_position:#x}")
    print(f"Dispatch channel  label +{dispatch_label:#x}")
    print(f"{len(names) - 1} message names, {len(receivers)} stream receivers")
    for check, ok in checks.items():
        print(f"{'ok  ' if ok else 'FAIL'}  {check}")
    if not all(checks.values()):
        sys.exit("setup: a check failed, so these offsets can't be trusted")

    build = os.path.join(BUILDS, uuid)
    os.makedirs(build, exist_ok=True)
    offsets = dict(enc_name=enc_name, enc_dest=enc_dest, enc_size=enc_size, enc_buffer=enc_buffer,
                   enc_inline=enc_inline, dec_name=dec_name, dec_dest=dec_dest, dec_size=dec_size,
                   dec_buffer=dec_buffer, dec_position=dec_position, dispatch_label=dispatch_label)
    probes = [f"pid$target:WebKit:WebKit??{r}??didReceiveStreamMessage?IPC??*" for r in receivers]
    entries = ",\n".join(p + ":entry" for p in probes)
    returns = ",\n".join(p + ":return" for p in probes)
    for name, gpu, copy in (("ipctap", False, False), ("ipctap-gpu", True, False),
                            ("ipctap-bytes", False, True), ("ipctap-gpu-bytes", True, True)):
        text = (D_SCRIPT + STREAM_CLAUSE) if gpu else D_SCRIPT
        # The GPU process's stream messages, thousands a second, overflowed 256k buffers in 3 of 4
        # traces on an M6, and in none of 2 with 1m.
        bufsize = "1m" if gpu else "256k"
        with open(os.path.join(build, name + ".d"), "w") as f:
            f.write(text.format(uuid=uuid, file=name + ".d", bufsize=bufsize, args=" <bytes>" if copy else "",
                                send=(LINE_AND_BYTES if copy else LINE).format(**SEND).format(**offsets),
                                receive=(LINE_AND_BYTES if copy else LINE).format(**RECEIVE).format(**offsets),
                                entries=entries, returns=returns, **offsets))
    with open(os.path.join(build, "names.tsv"), "w") as f:
        for i, (name, sender, receiver) in enumerate(names):
            f.write(f"{i}\t{name}\t{sender}\t{receiver}\n")
    # Written last, so a setup that stopped partway runs again. It names the libdispatch the scripts
    # read, which can change while WebKit stays the same.
    with open(os.path.join(build, "setup.json"), "w") as f:
        json.dump({"libdispatch": libdispatch}, f)
    print(f"wrote {os.path.relpath(build)} in {time.time() - started:.1f} s")


def run_setup():
    """setup, saying where to report it when it fails."""
    try:
        setup()
    except SystemExit as stop:
        if isinstance(stop.code, str):
            sys.exit(f"{stop.code}\nipctap is tested on macOS 27.0.1 so far. If this Mac's WebKit is new to it, "
                     f"please open an issue with this output at {ISSUES}")
        raise


def sip_on():
    """Whether System Integrity Protection may still restrict DTrace, from csrutil status."""
    status = subprocess.run(["csrutil", "status"], capture_output=True, text=True).stdout
    return "status: disabled" not in status and "DTrace Restrictions: disabled" not in status


def give_to_user(path):
    """Under sudo, give a file, or a folder and everything in it, to the user who ran sudo."""
    if "SUDO_UID" not in os.environ:
        return
    uid, gid = int(os.environ["SUDO_UID"]), int(os.environ["SUDO_GID"])
    os.chown(path, uid, gid)
    for folder, dirs, files in os.walk(path):
        for name in dirs + files:
            os.chown(os.path.join(folder, name), uid, gid)


# Trace


def all_processes():
    """Every process's name, as {pid: name}."""
    out = subprocess.run(["ps", "-axo", "pid=,comm="], capture_output=True, text=True).stdout
    return {int(pid): path.rsplit("/", 1)[-1] for pid, path in (line.split(None, 1) for line in out.splitlines())}


def app_processes(app, processes):
    """The app's own process, by executable name or pid, and the WebKit services macOS
    counts as the app's, as {pid: role}. For an app started from a shell, macOS can
    count the process that started it as responsible for the app and its services."""
    responsible = ctypes.CDLL(None).responsibility_get_pid_responsible_for_pid
    apps, services = set(), {}
    for pid, name in processes.items():
        if app in (name, str(pid)):
            apps.add(pid)
        elif name.startswith("com.apple.WebKit.WebContent"):
            services[pid] = "WebContent"
        elif name in ("com.apple.WebKit.GPU", "com.apple.WebKit.Networking"):
            services[pid] = name.rsplit(".", 1)[-1]
    owners = apps | {responsible(pid) for pid in apps}
    found = {pid: "UI" for pid in apps}
    found.update({pid: role for pid, role in services.items() if responsible(pid) in owners})
    return found


def port_receivers(pids):
    """From one lsmp snapshot of every process, the process that receives each port of
    pids, as {(pid, port name): receiving pid}. A send right's receiver is the process
    whose receive right has the same ipc-object."""
    with tempfile.TemporaryDirectory() as folder:
        path = os.path.join(folder, "lsmp.json")
        subprocess.run(["lsmp", "-a", "-j", path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        with open(path) as f:
            processes = json.load(f)["processes"]
    receivers = {port["ipc-object"]: process["pid"] for process in processes for port in process.get("ports", [])
                 if "recv" in port.get("rights", [])}
    return {(process["pid"], int(port["name"], 16)): receivers[port["ipc-object"]]
            for process in processes if process["pid"] in pids for port in process.get("ports", [])
            if port.get("ipc-object") in receivers and port.get("name", "").startswith("0x")}


def parse(line, pid, role, names):
    """A dtrace line as a message record, or None for anything else. A Mach message's
    other end is filled in later, from lsmp."""
    parts = line.split()
    if parts and parts[0] == "mach":
        when, thread, port, ident, size, right = map(int, parts[1:7])
        label = " ".join(parts[7:])
        return {"time": when, "pid": pid, "process": role, "thread": thread, "direction": "mach", "peer": "?",
                "peer_pid": None, "service": None if label == "-" else label, "id": ident, "port": port,
                "size": size, "send_once": right == 18}
    if not parts or parts[0] not in ("send", "receive", "stream"):
        return None
    direction, when, thread, ident, dest = parts[0], *map(int, parts[1:5])
    name, sender, receiver = names[ident] if ident < len(names) else (f"#{ident}", "?", "?")
    return {"time": when, "pid": pid, "process": role, "thread": thread, "direction": direction,
            "peer": receiver if direction == "send" else sender, "peer_pid": None, "message": name, "id": ident,
            "destination": dest, "size": int(parts[5]) if direction != "stream" else None}


def clock(ns):
    seconds, ns = divmod(ns, 10**9)
    return time.strftime("%H:%M:%S", time.localtime(seconds)) + f".{ns // 1000:06d}"


def hexdump(data, size):
    """Rows of 16 bytes in two groups of 8, with the text between bars, like hexdump -C.
    A row the same as the one before shows as one *, and a cut copy ends with how much
    of the message it holds."""
    rows, previous, repeating = [], None, False
    for i in range(0, len(data), 16):
        row = data[i:i + 16]
        if row == previous and i + 16 < len(data):
            if not repeating:
                rows.append(f"{'':17}*")
            repeating = True
            continue
        previous, repeating = row, False
        hex_part = "  ".join(" ".join(f"{b:02x}" for b in half) for half in (row[:8], row[8:]) if half)
        text = "".join(chr(b) if 32 <= b < 127 else "." for b in row)
        rows.append(f"{'':17}{i:04x}  {hex_part:<48}  |{text}|")
    if size > len(data):
        rows.append(f"{'':23}{len(data)} of {size} bytes")
    return "\n".join(rows)


def matches(m, processes, patterns):
    """Whether a message passes -p, which names roles or pids, and -m, which gives message or
    service names with wildcards. Repeating an option allows more."""
    if processes and m["process"].lower() not in processes and str(m["pid"]) not in processes:
        return False
    name = (m.get("message") or m.get("service") or "").lower()
    return not patterns or any(fnmatch.fnmatchcase(name, pattern.lower()) for pattern in patterns)


def show(m):
    process = f"{m['process']} {m['pid']}"
    arrow = "<-" if m["direction"] in ("receive", "stream") else "->"
    peer = f"{m['peer']} {m['peer_pid']}" if m["peer_pid"] else m["peer"]
    if m["direction"] == "mach":
        # An XPC service often runs as a process of the same name, already shown as the other end.
        service = m["service"] if m["service"] and m["service"] != m["peer"] else None
        message = f"{service} {m['id']:#x}" if service else f"{m['id']:#x}" if m["service"] else f"msgh_id {m['id']:#x}"
        return f"{clock(m['time'])}  {process:<17} {arrow} {peer:<17} {message}  port {m['port']:#x}  {m['size']} bytes"
    size = "" if m["size"] is None else f"{m['size']} bytes"
    if m["direction"] == "stream":
        size = f"{size} (stream)".lstrip()
    text = f"{clock(m['time'])}  {process:<17} {arrow} {peer:<17} {m['message']}  dest {m['destination']}  {size}"
    if m.get("bytes"):
        text += "\n" + hexdump(bytes.fromhex(m["bytes"]), m["size"]) + "\n"
    return text


def show_file(path, processes, patterns):
    """Print a trace that trace saved as ndjson, with the same filters. A last line
    cut short, as when trace was killed, is left out."""
    try:
        f = sys.stdin if path == "-" else open(path)
    except OSError as error:
        sys.exit(f"ipctap: can't read {path}: {error.strerror}")
    name = "standard input" if path == "-" else path
    cut = None
    try:
        with f:
            for number, line in enumerate(f, 1):
                if not line.strip():
                    continue
                if cut:
                    break
                try:
                    m = json.loads(line)
                except ValueError:
                    cut = number
                    continue
                try:
                    if matches(m, processes, patterns):
                        print(show(m))
                except (KeyError, TypeError, AttributeError):
                    sys.exit(f"ipctap: line {number} of {name} isn't a message from ipctap trace")
            else:
                if cut:
                    print(f"ipctap: left out line {cut}, which was cut short", file=sys.stderr)
                return
    except BrokenPipeError:
        sys.stdout = open(os.devnull, "w")
        return
    sys.exit(f"ipctap: line {cut} of {name} isn't a message from ipctap trace")


def trace(app, output, seconds, nbytes, processes, patterns):
    if os.geteuid() != 0:
        sys.exit("trace needs root for DTrace. Run sudo ./ipctap trace")
    if nbytes is not None and not 1 <= nbytes <= 4096:
        sys.exit("--bytes takes a number from 1 to 4096")

    def note(text):
        print(f"ipctap: {text}", file=sys.stderr, flush=True)

    uuid, libdispatch = uuids()
    build = os.path.join(BUILDS, uuid)

    def setup_done():
        try:
            with open(os.path.join(build, "setup.json")) as f:
                return json.load(f).get("libdispatch") == libdispatch
        except FileNotFoundError:
            return False

    if not setup_done():
        note("this Mac's WebKit has no setup yet, so running it first")
        with contextlib.redirect_stdout(sys.stderr):
            run_setup()
        give_to_user(BUILDS)
    with open(os.path.join(build, "names.tsv")) as f:
        names = [tuple(line.rstrip("\n").split("\t")[1:]) for line in f]
    output = output or time.strftime("ipctap-%Y%m%d-%H%M%S.ndjson")
    out = open(output, "w")
    give_to_user(output)

    stop = threading.Event()
    signal.signal(signal.SIGINT, lambda *_: stop.set())
    signal.signal(signal.SIGTERM, lambda *_: stop.set())
    lines = queue.Queue()
    tracers = {}  # pid -> dtrace process, while it runs
    roles = {}  # pid -> role, for every process traced
    problems, reported = [], set()  # the first DTrace error of each kind, and the kinds, with numbers taken out

    def read(pid, role, stream):
        for line in stream:
            lines.put((pid, role, line))
        lines.put((pid, role, None))

    # DTrace's errors come on their own pipe, so that none lands in the middle of a message's line.
    # Each kind shows once, rather than once for every process.
    def errors(pid, role, stream):
        for line in stream:
            text = line.strip()
            kind = re.sub(r"0x[0-9a-f]+|\d+", "", text)
            if text and kind not in reported:
                reported.add(kind)
                problems.append(text)
                note(f"{role} {pid}: {text}")

    def attach(pid, role):
        script = os.path.join(build, ("ipctap-gpu" if role == "GPU" else "ipctap") + ("-bytes.d" if nbytes else ".d"))
        dtrace = subprocess.Popen(["/usr/sbin/dtrace", "-q", "-s", script, "-p", str(pid)] + ([str(nbytes)] if nbytes else []),
                                  stdout=subprocess.PIPE, stderr=subprocess.PIPE, bufsize=1,
                                  encoding="utf-8", errors="backslashreplace")  # DTrace can print bytes that aren't UTF-8
        tracers[pid] = dtrace
        roles[pid] = role
        threading.Thread(target=read, args=(pid, role, dtrace.stdout), daemon=True).start()
        threading.Thread(target=errors, args=(pid, role, dtrace.stderr), daemon=True).start()

    # Messages from different processes, and from different CPUs in one process, arrive out of
    # order. Each waits briefly in pending, a heap by time, so they print in time order.
    pending, order = [], itertools.count()
    count, total, mach, traced = 0, 0, 0, set()  # for the closing note
    # A Mach message's other end comes from lsmp snapshots of every process's ports. A snapshot
    # takes about 0.7 s, so a thread takes them, at most one a second.
    ports = {}  # (pid, port name) -> the pid that receives it, from the last snapshot
    snapshot = asked = 0  # when the last snapshot started, and when one was last asked for
    missing = set()  # (pid, port name) pairs that a snapshot started after their message didn't have
    names_now = {}  # pid -> process name, from the last ps
    snapshots = queue.Queue()  # the pids for each snapshot asked for

    def take_snapshots():
        nonlocal ports, snapshot
        while True:
            pids = snapshots.get()
            started = time.time_ns()
            ports = port_receivers(pids)
            snapshot = started
            time.sleep(max(0.0, 1 - (time.time_ns() - started) / 1e9))

    threading.Thread(target=take_snapshots, daemon=True).start()

    def waits_for_snapshot(m):
        """Whether a Mach message should wait for a newer snapshot: its port is unknown,
        no snapshot started after it, and it's under HOLD old. Not for a send-once
        right, which a snapshot has only while it's held, or an XPC message, whose
        channel label names the service or whose connection is often gone by then."""
        if m["direction"] != "mach" or m["send_once"] or m["id"] in XPC_IDS or (m["pid"], m["port"]) in ports:
            return False
        if snapshot > m["time"]:
            missing.add((m["pid"], m["port"]))
        return (m["pid"], m["port"]) not in missing and time.time_ns() - m["time"] < HOLD

    # Recent sends and receives by direction, message and destination, to find the other end.
    recent = collections.defaultdict(collections.deque)
    # Stream messages waiting to print, by pid, thread and time, for their size.
    streams = {}
    # With --bytes, the message whose dump is being read, and the bytes so far, by pid.
    dumps = {}
    next_prune = 0

    def peer_pid(m):
        """The process at the other end of a send or receive, when exactly one other
        traced process received or sent the same message for the same destination
        within PAIRING of it."""
        if m["direction"] == "send":
            other, start, end = "receive", m["time"], m["time"] + PAIRING
        else:
            other, start, end = "send", m["time"] - PAIRING, m["time"]
        pids = {pid for when, pid in recent.get((other, m["id"], m["destination"]), ())
                if start <= when <= end and pid != m["pid"]}
        return pids.pop() if len(pids) == 1 else None

    def flush(older_than, final=False):
        nonlocal count, total, mach, recent, next_prune, asked
        shown = []
        while pending and pending[0][0] < older_than:
            m = pending[0][2]
            if not final and waits_for_snapshot(m):
                if asked <= snapshot:
                    asked = time.time_ns()
                    snapshots.put(set(roles))
                break
            heapq.heappop(pending)
            if m["direction"] == "mach":
                del m["send_once"]
                m["peer_pid"] = ports.get((m["pid"], m["port"]))
                if m["peer_pid"] == m["pid"]:
                    continue
                m["peer"] = roles.get(m["peer_pid"]) or names_now.get(m["peer_pid"], "?")
            elif m["direction"] == "stream":
                streams.pop((m["pid"], m["thread"], m["time"]), None)
            else:
                m["peer_pid"] = peer_pid(m)
                if m["peer_pid"]:
                    m["peer"] = roles[m["peer_pid"]]
            total += 1
            if not matches(m, processes, patterns):
                continue
            out.write(json.dumps(m) + "\n")
            count += 1
            mach += m["direction"] == "mach"
            traced.add(m["pid"])
            shown.append(show(m))
        try:
            if shown:
                print("\n".join(shown), flush=True)
        except BrokenPipeError:
            sys.stdout = open(os.devnull, "w")
            stop.set()
        if time.time() >= next_prune:
            # Messages held for a snapshot still need the sends and receives around them.
            cutoff = min(older_than, pending[0][0] if pending else older_than) - 2 * PAIRING
            for times in recent.values():
                while times and times[0][0] < cutoff:
                    times.popleft()
            recent = collections.defaultdict(collections.deque, {key: times for key, times in recent.items() if times})
            next_prune = time.time() + 1

    # Every CoreIPC message starts with its flags, its number at offset 2 and its destination at
    # offset 8. The D scripts copy a message's bytes only when its buffer starts with its number, so
    # a message without bytes, or with bytes for another header, means setup found the wrong buffer.
    mismatches = 0

    def mismatch(m):
        nonlocal mismatches
        mismatches += 1
        if mismatches == 1:
            note(f"{m['message']} came without bytes that start with its number and destination, "
                 "so the buffer setup found may be wrong. Don't trust --bytes on this build.")

    def check_header(m, data):
        head = bytes(data[:min(len(data), m["size"], 16)])
        number, dest = m["id"].to_bytes(2, "little"), m["destination"].to_bytes(8, "little")
        if head[2:4] != number[:len(head[2:4])] or head[8:16] != dest[:len(head[8:16])]:
            mismatch(m)

    def handle(item):
        nonlocal first_ready
        pid, role, line = item
        if line is None:
            tracers.pop(pid, None)
            return
        if pid in dumps:
            # A dump is a blank line, a header and rows like "  10: 03 0c 00 ...  ascii".
            row = re.match(r"\s+[0-9a-f]+: ((?:[0-9a-f]{2} )+)", line)
            if row:
                m, data = dumps[pid]
                data += bytes.fromhex(row[1])
                if len(data) >= nbytes:
                    m["bytes"] = data[:min(m["size"], nbytes)].hex()
                    del dumps[pid]
                    check_header(m, data)
                return
            if not line.strip() or "0123456789abcdef" in line:
                return
            mismatch(dumps.pop(pid)[0])
        m = parse(line, pid, role, names)
        if m:
            heapq.heappush(pending, (m["time"], next(order), m))
            if m["direction"] == "stream":
                streams[(pid, m["thread"], m["time"])] = m
            elif m["direction"] != "mach":
                recent[(m["direction"], m["id"], m["destination"])].append((m["time"], pid))
            if nbytes:
                m["bytes"] = None
                if m["direction"] in ("send", "receive"):
                    dumps[pid] = (m, bytearray())
        elif line.startswith("size "):
            when, thread, size = map(int, line.split()[1:])
            m = streams.get((pid, thread, when))
            if m and m["size"] is None and 0 < size < 1 << 31:
                m["size"] = size
        elif line.startswith("ready "):
            first_ready = first_ready or time.time()
            note(f"tracing {role} {pid} from {clock(int(line.split()[1]))}")
        elif line.strip():
            note(f"{role} {pid}: {line.strip()}")

    def receive(timeout):
        try:
            handle(lines.get(timeout=timeout))
            for _ in range(20000):
                handle(lines.get_nowait())
        except queue.Empty:
            pass

    note(f"{app} with WebKit {uuid}, writing {output}. Ctrl-C stops.")
    # -t counts from when the first process is traced, so it's that long of tracing. While no
    # process is being attached, it counts from the start, so a trace of an app that never runs ends.
    started, first_attach, first_ready, next_scan, waiting, slow = time.time(), None, None, 0, False, False
    try:
        while not stop.is_set():
            now = time.time()
            since = first_ready or (None if roles else started)
            if seconds and since and now >= since + seconds:
                break
            if now >= next_scan:
                names_now = all_processes()
                found = app_processes(app, names_now)
                if not found and not roles and not waiting:
                    note(f"{app} isn't running. Waiting for it.")
                    waiting = True
                for pid, role in found.items():
                    if pid not in roles:
                        attach(pid, role)
                        first_attach = first_attach or now
                next_scan = time.time() + 0.5
            receive(0.1)
            flush(time.time_ns() - 500_000_000)
            if roles and not first_ready:
                if not tracers or now - first_attach > 120:
                    break  # every DTrace stopped, or none got ready in 2 minutes
                if now - first_attach > 5 and not slow:
                    note("DTrace is still getting ready, which can take a minute the first time on a Mac.")
                    slow = True
    finally:
        # Even if ipctap fails, every DTrace stops and lets go of its process.
        for dtrace in tracers.values():
            if dtrace.poll() is None:
                dtrace.send_signal(signal.SIGINT)
    give_up = time.time() + 5
    while tracers and time.time() < give_up:
        receive(0.1)
    for dtrace in tracers.values():
        dtrace.kill()
    flush(float("inf"), final=True)
    out.close()
    if mismatches:
        note(f"{mismatches} messages came without bytes that match their header")
    if not first_ready:
        if not roles:
            sys.exit(f"ipctap: traced nothing, because {app} never ran.")
        if not problems:
            sys.exit(f"ipctap: traced nothing, because DTrace wasn't ready after {time.time() - first_attach:.0f} s. "
                     "The first trace on a Mac can take a minute.")
        hint = ("ipctap needs root and System Integrity Protection off, and SIP is on. "
                "See Requirements in the README." if sip_on() else
                f"If this keeps happening, please open an issue with this output at {ISSUES}")
        sys.exit(f"ipctap: traced nothing. DTrace said: {problems[0]}\nipctap: {hint}")
    def many(n, word):
        return f"{n} {word}" if n == 1 else f"{n} {word}es" if word.endswith("s") else f"{n} {word}s"

    counted = f"{count} of {many(total, 'message')} matched -p and -m," if processes or patterns else many(count, "message")
    note(f"{counted} from {many(len(traced), 'process')}, {mach} of them other Mach messages, written to {output}")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--version", action="version", version=f"ipctap {VERSION}")
    commands = parser.add_subparsers(dest="command", required=True)
    filters = argparse.ArgumentParser(add_help=False)
    filters.add_argument("-p", metavar="PROCESS", action="append", default=[], dest="processes",
                         help="only this process: UI, WebContent, GPU, Networking or a pid (repeatable)")
    filters.add_argument("-m", metavar="MESSAGE", action="append", default=[], dest="patterns",
                         help="only messages or services with this name, * and ? allowed (repeatable)")
    tracing = commands.add_parser("trace", parents=[filters])
    tracing.add_argument("-a", metavar="APP", default="Safari",
                         help="the app, by the name of its executable or its pid (default Safari)")
    tracing.add_argument("-o", metavar="FILE", help="ndjson output (default ipctap-<date>-<time>.ndjson)")
    tracing.add_argument("-t", metavar="SECONDS", type=float, help="stop after this many seconds")
    tracing.add_argument("--bytes", metavar="N", nargs="?", type=int, const=256,
                         help="also copy each CoreIPC message's first N bytes (default 256) and print them")
    showing = commands.add_parser("show", parents=[filters])
    showing.add_argument("file", help="an ndjson file from trace, or - for standard input")
    commands.add_parser("setup")
    args = parser.parse_args()
    roles = {"ui", "webcontent", "gpu", "networking"}
    processes = {value.lower() for value in getattr(args, "processes", [])}
    if any(value not in roles and not value.isdigit() for value in processes):
        parser.error("-p takes UI, WebContent, GPU, Networking or a pid")
    if args.command == "setup":
        run_setup()
    elif args.command == "show":
        show_file(args.file, processes, args.patterns)
    else:
        trace(args.a, args.o, args.t, args.bytes, processes, args.patterns)


if __name__ == "__main__":
    main()
